
---

## 3️⃣ .gitignore

```gitignore
# ============================================
# DEPENDENCIAS
# ============================================
node_modules/
bower_components/
.pnp/
.pnp.js

# ============================================
# VARIABLES DE ENTORNO (¡NUNCA subir secretos!)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ============================================
# LOGS
# ============================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ============================================
# EDITORES E IDEs
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ============================================
# SISTEMA OPERATIVO
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================
# BUILD / DISTRIBUCIÓN
# ============================================
dist/
build/
out/
.next/
.nuxt/
.output/
.cache/
.temp/

# ============================================
# TESTING
# ============================================
coverage/
.nyc_output/
*.lcov
jest.html

# ============================================
# TEMPORALES
# ============================================
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ============================================
# IMÁGENES DE DESARROLLO
# ============================================
# Mantener solo las de producción
# assets/images/dev/
# assets/images/temp/

# ============================================
# BACKUPS
# ============================================
*.backup
*.old
*.orig
backups/

# ============================================
# DOCUMENTOS SENSIBLES
# ============================================
*.key
*.pem
*.crt
*.p12
credentials.json
service-account.json

# ============================================
# DATABASE
# ============================================
*.sqlite
*.sqlite3
*.db
database/

# ============================================
# MISC
# ============================================
.vercel
.netlify
.firebase
.firebase/
firebase-debug.log
firestore-debug.log